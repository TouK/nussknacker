{
  "verbose": false,
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "/",
        "~/"
      ],
      "allowRead": [
        "/etc/hosts",
        "~/.sbt/boot",
        "~/.ivy2",
        "~/.cache/coursier",
        "~/.docker",
        "~/.kube",
        "~/.sdkman",
        "~/.npm",
        "~/.nvm",
        "~/.local",
        "."
      ],
      "allowWrite": [
        "/tmp"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "1500000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(sdk *)",
      "Bash(sbt *)",
      "Bash(nvm *)",
      "Bash(npm *)",
      "Bash(jar *)",
      "Bash(git *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(chmod 777 *)",
      "Bash(sudo *)"
    ]
  }
}

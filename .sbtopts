-J-Xss6M
-J-Xms2g
-J-Xmx6g
-J-XX:ReservedCodeCacheSize=256M
-J-XX:NonProfiledCodeHeapSize=196m
-J-XX:MaxMetaspaceSize=5g
-J-XX:+UnlockExperimentalVMOptions
-J-XX:-UseJVMCICompiler
-J--add-exports=java.base/sun.net.util=ALL-UNNAMED
-J--add-exports=java.rmi/sun.rmi.registry=ALL-UNNAMED
-J--add-exports=java.security.jgss/sun.security.krb5=ALL-UNNAMED
-J--add-opens=java.base/java.lang=ALL-UNNAMED
-J--add-opens=java.base/java.net=ALL-UNNAMED
-J--add-opens=java.base/java.io=ALL-UNNAMED
-J--add-opens=java.base/java.nio=ALL-UNNAMED
-J--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
-J--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
-J--add-opens=java.base/java.text=ALL-UNNAMED
-J--add-opens=java.base/java.time=ALL-UNNAMED
-J--add-opens=java.base/java.util=ALL-UNNAMED
-J--add-opens=java.base/java.math=ALL-UNNAMED
-J--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
-J--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
-J--add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED
-J--add-opens=java.base/java.nio.charset=ALL-UNNAMED
-J--add-opens=java.base/sun.nio.cs=ALL-UNNAMED
-J--add-opens=java.sql/java.sql=ALL-UNNAMED

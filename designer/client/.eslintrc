{
    "root": false,
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "env": {
        "browser": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "plugin:react-hooks/recommended",
        "plugin:@typescript-eslint/recommended",
        "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint", "i18next", "import"],
    "rules": {
        "i18next/no-literal-string": [
            "error",
            {
                "ignore": ["-icon", ".svg", ".jpg", ".jpeg", ".png"],
                "ignoreCallee": [
                    "t",
                    "withTranslation",
                    "useTranslation",
                    "reportEvent",
                    "headerStyles",
                    "_.get",
                    "_.pick",
                    "_.has",
                    "classNames",
                    "classnames",
                    "cx",
                    "api.get",
                    "api.post",
                    "describe",
                    "css",
                    "querySelector",
                    "querySelectorAll"
                ],
                "ignoreAttribute": [
                    "onHandleColor",
                    "svgFile",
                    "bounds",
                    "handle",
                    "column",
                    "glyph",
                    "value",
                    "style",
                    "classNames",
                    "className",
                    "valueClassName",
                    "rowClassName",
                    "fieldType",
                    "classNamePrefix"
                ]
            }
        ],
        "react/prop-types": "off",
        "react-hooks/exhaustive-deps": [
            "error",
            {
                "additionalHooks": "(useDrop|useDrag|useCallbackRef|useRegisterCommands)$"
            }
        ],
        "import/order": [
          "error",
          {
            "groups": ["builtin", "external", ["internal", "parent", "sibling", "index"]],
            "newlines-between": "always",
            "alphabetize": {
              "order": "asc",
              "caseInsensitive": true
            }
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ImportNamespaceSpecifier",
            "message": "Wildcard imports are not allowed."
          }
        ],
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "disallowTypeAnnotations": false
          }
        ]
    },
    "overrides": [
        {
            "files": ["!src/**/*"],
            "rules": {
                "@typescript-eslint/no-var-requires": "off"
            }
        },
        {
            "files": ["**/*.ts"],
            "parserOptions": {
                "project": "eslint.tsconfig.json"
            }
        },
        {
            "files": ["cypress/**/*.ts"],
            "parserOptions": {
                "project": "cypress/tsconfig.json"
            }
        },
        {
          "files": [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*-test.ts",
            "**/*-test.tsx"
          ],
          "plugins": ["eslint-plugin-jest"],
          "extends": ["plugin:jest/recommended"],
          "rules": {
            "jest/expect-expect": [
              "warn",
              {
                "assertFunctionNames": ["expect", "tstyche.expect"]
              }
            ],
            "no-restricted-syntax": "off"
          }
        }
    ]
}
